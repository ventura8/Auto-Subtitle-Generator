FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv to manage hermetic Python 3.12 on Ubuntu 26.04
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /root/.local/bin/
ENV PATH="/root/.local/bin:$PATH"
ENV UV_PYTHON_INSTALL_DIR="/opt/uv/python"
RUN uv python install 3.12.14

WORKDIR /app
# Copy only what the installer and the E2E suite need; never the whole build
# context, so local secrets, caches or media can't leak into the image.
COPY pyproject.toml poetry.lock poetry.toml pytest.ini pyrightconfig.json config.yaml      auto_subtitle.py install_dependencies.sh start.sh run_local_pipeline.sh /app/
COPY modules /app/modules
COPY tests /app/tests
COPY typings /app/typings

RUN chmod +x install_dependencies.sh start.sh run_local_pipeline.sh
RUN ./install_dependencies.sh ml,dev
RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app

USER appuser
CMD [".venv/bin/python", "-m", "pytest", "tests/e2e/test_real_pipeline.py", "-v"]
